#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  network:
    network:
      version: 2
      ethernets:
        any:
          match:
            name: "en*"
          dhcp4: true
  storage:
    layout:
      name: lvm
    swap:
      size: 0
  identity:
    hostname: kosmos
    username: kosmos
    # password: kosmos
    # Hash uses a static salt (intentional for a dev image — do not reuse for production).
    # Regenerate with: python3 -c "import crypt; print(crypt.crypt('yourpass', crypt.mksalt(crypt.METHOD_SHA512)))"
    password: "$6$rounds=4096$saltsaltsalt$auhF/gtdoDJ4Unxg24MB7nby3LZxJMrf9WENjHOTiWSB1E5Ye4yk3fjzO0rqGctslG5mNh6EFSndRf4HwtbCE."
  ssh:
    install-server: true
    allow-pw: false
    # Official autoinstall mechanism for injecting authorized keys — handled by
    # the installer directly, so no manual ~/.ssh setup needed in late-commands.
    authorized-keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIONEzIUmy0nbSq6l+0qMFzpKMB2bIylfGyHQr5gdIR1/ packer-build"
  # Disable geoip mirror selection (requires an extra HTTP call that can fail
  # inside QEMU NAT). Pin archive.ubuntu.com directly for a stable build.
  apt:
    geoip: false
    preserve_sources_list: false
    primary:
      - arches: [amd64]
        uri: http://archive.ubuntu.com/ubuntu

  # No packages installed by the installer — Ansible base role handles all of
  # this. Keeping the installer lean avoids apt-get update failures during the
  # install phase, which are a common source of flaky builds.
  user-data:
    disable_root: true
  late-commands:
    - echo 'kosmos ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/kosmos
    - chmod 440 /target/etc/sudoers.d/kosmos
