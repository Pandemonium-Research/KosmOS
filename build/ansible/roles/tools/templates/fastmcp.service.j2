[Unit]
Description=KosmOS FastMCP tool server
After=network.target

[Service]
Type=simple
User={{ kosmos_user }}
EnvironmentFile={{ kosmos_config_dir }}/env
Environment="FASTMCP_PORT={{ fastmcp_port }}"
Environment="KOSMOS_WORKSPACE={{ kosmos_home }}/workspace"
ExecStart={{ kosmos_venv }}/bin/python /opt/kosmos/mcp/server.py
Restart=always
RestartSec=5
StandardOutput=append:{{ kosmos_log_dir }}/fastmcp.log
StandardError=append:{{ kosmos_log_dir }}/fastmcp.log

[Install]
WantedBy=multi-user.target
