version: "3.8"

services:
  searxng:
    image: searxng/searxng:latest
    container_name: searxng
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ searxng_port }}:8080"
    volumes:
      - /opt/kosmos/searxng:/etc/searxng:rw
    environment:
      - SEARXNG_BASE_URL=http://localhost:{{ searxng_port }}
      - UWSGI_WORKERS=2
      - UWSGI_THREADS=2
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
      - DAC_OVERRIDE
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
