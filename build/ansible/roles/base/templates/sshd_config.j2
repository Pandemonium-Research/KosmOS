# KosmOS sshd_config — hardened defaults
Port 22
Protocol 2
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Auth
PermitRootLogin no
PasswordAuthentication yes        # password auth ON for image usability
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PermitEmptyPasswords no
ChallengeResponseAuthentication no
UsePAM yes

# Hardening
X11Forwarding no
AllowTcpForwarding yes            # needed for port-forwarding to services
MaxAuthTries 4
LoginGraceTime 30
MaxSessions 10

# Logging
SyslogFacility AUTH
LogLevel INFO

# Misc
PrintMotd yes
Banner /etc/issue.net
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server
