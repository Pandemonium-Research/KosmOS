server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://127.0.0.1:{{ loki_port }}/loki/api/v1/push

scrape_configs:
  - job_name: kosmos-services
    static_configs:
      - targets: ["localhost"]
        labels:
          job: kosmos
          __path__: {{ kosmos_log_dir }}/*.log

  - job_name: journal
    journal:
      max_age: 12h
      labels:
        job: systemd
    relabel_configs:
      - source_labels: ["__journal__systemd_unit"]
        target_label: unit
