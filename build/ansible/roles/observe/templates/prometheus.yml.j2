global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: node
    static_configs:
      - targets: ["127.0.0.1:9100"]

  - job_name: ollama
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ ollama_host }}:{{ ollama_port }}"]

  - job_name: litellm
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:{{ litellm_port }}"]

  - job_name: chromadb
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:{{ chromadb_port }}"]
