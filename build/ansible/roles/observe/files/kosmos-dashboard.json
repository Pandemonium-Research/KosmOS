{
  "title": "KosmOS",
  "uid": "kosmos-main",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["kosmos"],
  "panels": [
    {
      "id": 1,
      "title": "Service Health",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "up",
          "legendFormat": "{{ job }}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "id": 2,
      "title": "CPU Usage %",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 3, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory Usage %",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 3, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "Memory"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ollama — Active Requests",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "ollama_requests_total",
          "legendFormat": "{{ model }}"
        }
      ]
    },
    {
      "id": 5,
      "title": "LiteLLM — Request Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(litellm_request_total[1m])",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 6,
      "title": "KosmOS Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "expr": "{job=\"kosmos\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
