# KosmOS environment — API key template.
# Copy this file to /etc/kosmos/env on your running image and fill in your keys.
# The file is already created with empty values at /etc/kosmos/env on first boot.
#
# All KosmOS systemd services source /etc/kosmos/env automatically.
# Your shell also sources it via ~/.bashrc.
#
# Local models (Ollama) work without any keys.
# Cloud models via LiteLLM are activated when their key is set.

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional: LiteLLM master key (change for shared deployments) ──────────────
LITELLM_MASTER_KEY=kosmos-local
